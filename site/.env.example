# ─────────────────────────────────────────────────────────────────────────────
#  Variables d'environnement — copiez ce fichier en `.env.local` (développement)
#  ou renseignez-les dans l'interface de votre hébergeur (production).
#  Le fichier `.env.local` ne doit JAMAIS être versionné (déjà exclu par .gitignore).
#
#  Les variables préfixées NEXT_PUBLIC_ sont visibles dans le navigateur :
#  n'y mettez jamais de secret. Elles sont lues au moment du build :
#  relancez `npm run build` après les avoir modifiées.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site & SEO ───────────────────────────────────────────────────────────────
# URL publique, sans barre finale (canoniques, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
# Mettre à "true" UNIQUEMENT quand le site est prêt (contenus, mentions légales).
# Tant que ce n'est pas le cas, robots.txt et les balises meta bloquent l'indexation.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Envoi des formulaires (côté serveur uniquement) ───────────────────────────
# Fournisseur : "resend" (recommandé) ou "smtp".
EMAIL_PROVIDER=resend
# Expéditeur : doit appartenir à un domaine vérifié chez le fournisseur.
EMAIL_FROM="Site de l'agence <devis@exemple.fr>"
# Adresse(s) qui reçoivent les demandes (séparées par des virgules).
CONTACT_TO_EMAIL=contact@exemple.fr
# Envoyer un accusé de réception au client s'il le demande (case à cocher affichée).
SEND_CLIENT_CONFIRMATION=false

# Option 1 — Resend (https://resend.com) : clé API commençant par re_
RESEND_API_KEY=

# Option 2 — SMTP (OVH, Gmail Workspace, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
# "true" pour le port 465 (SSL), "false" pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Prise de rendez-vous (Cal.com ou équivalent) ──────────────────────────────
# URL publique de l'événement de réservation, ex. https://cal.com/mon-agence/appel-decouverte
NEXT_PUBLIC_BOOKING_URL=
# Durée affichée sur le site (doit correspondre à celle paramétrée dans Cal.com).
NEXT_PUBLIC_BOOKING_DURATION_MINUTES=20

# ── Protection anti-robots optionnelle (Cloudflare Turnstile) ─────────────────
# Recommandée sur un hébergement serverless (Vercel…), où la limitation par IP
# en mémoire est moins efficace. Laisser vide pour désactiver.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
